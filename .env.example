# Необязательно: без заданного пароля панель сгенерирует его в постоянном томе.
DEPLOYIT_ADMIN_USERNAME=admin
DEPLOYIT_ADMIN_PASSWORD=
DEPLOYIT_PORT=8080
# Сколько разных проектов можно разворачивать одновременно (1–32).
DEPLOYIT_MAX_PARALLEL_DEPLOYMENTS=4
# Для доступа через SSH-туннель или локальный reverse proxy.
DEPLOYIT_BIND_ADDRESS=127.0.0.1

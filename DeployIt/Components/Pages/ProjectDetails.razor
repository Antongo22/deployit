@page "/projects/{Id:guid}"
@attribute [Authorize]
@implements IDisposable
@inject ProjectService Service
@inject SshDeploymentService Ssh
@inject NavigationManager Navigation
<PageTitle>@(project?.Name ?? "Проект") · DeployIt</PageTitle>
<a class="back-link" href="/">← Все проекты</a>
@if (error is not null) { <div class="alert error" role="alert">@error</div> }
@if (message is not null) { <div class="alert success">@message</div> }
@if (project is null) { <div class="empty">Загрузка проекта…</div> }
else
{
    <div class="page-heading"><div><div class="eyebrow">@project.RepositoryName</div><h1>@project.Name<span class="heading-dot">.</span></h1><div class="inline-actions"><StatusBadge Status="project.LatestDeployment?.Status" /><span class="muted mono">⌘ @project.Branch</span></div></div>
        <div class="inline-actions"><a class="button" href="@($"/projects/{Id}/edit")">Настройки</a><button class="button primary" disabled="@(busy || Ui.Active(project.LatestDeployment?.Status))" @onclick="Deploy">@(Ui.Active(project.LatestDeployment?.Status) ? "Деплой в работе…" : "Развернуть ↗")</button></div>
    </div>
    <div class="details-grid"><section class="panel"><div class="section-heading"><h2>Целевой сервер</h2><span class="tag">SSH</span></div><strong class="server-address">@project.Username@@@project.Host:@project.Port</strong><p class="mono muted">@project.WorkingDirectory</p><small class="mono fingerprint">@project.HostFingerprint</small><button class="button subtle" disabled="@busy" @onclick="Check">Проверить SSH</button></section>
        <section class="panel"><h2>Команда деплоя</h2><pre class="command">@project.DeployCommand</pre><div class="muted">Ветка <code>@project.Branch</code> · Таймаут @project.TimeoutMinutes мин.</div><p class="form-note">Последний успешный коммит: <code>@Ui.Commit(project.LastSuccessfulDeployment?.CommitSha)</code></p></section></div>
    <section class="panel history-panel"><div class="section-heading"><h2>История запусков</h2><small class="muted">Время МСК · последние 100 запусков</small></div>
    @if (history.Count == 0) { <div class="empty small"><p>Запусков пока нет. Нажмите «Развернуть», чтобы получить код и выполнить команду.</p></div> }
    else { <div class="table-scroll"><table><thead><tr><th>ЗАПУСК</th><th>СТАТУС</th><th>КОММИТ</th><th>СОЗДАН</th><th>КОД</th><th></th></tr></thead><tbody>@foreach (var run in history) { <tr class="@(selected?.Id == run.Id ? "selected" : "")"><td><code>@run.Id.ToString("N")[..8]</code></td><td><StatusBadge Status="run.Status" /></td><td><code>@Ui.Commit(run.CommitSha)</code></td><td>@Ui.Time(run.CreatedAt)</td><td>@(run.ExitCode?.ToString() ?? "—")</td><td><button class="button subtle" @onclick="() => Select(run.Id)">Журнал ↗</button></td></tr> }</tbody></table></div> }
    </section>
    @if (selected is not null) { <section class="terminal"><div class="terminal-header"><div><span class="terminal-dots">● ● ●</span> deployment / @selected.Id.ToString("N")[..8]</div><StatusBadge Status="selected.Status" /></div><pre aria-live="polite">@(string.IsNullOrEmpty(selected.Log) ? "Ожидание запуска…" : selected.Log)</pre><div class="terminal-footer">@if (Ui.Active(selected.Status)) { <span class="accent">● Журнал обновляется автоматически</span> } else { <span>Начало @Ui.Time(selected.StartedAt) · Конец @Ui.Time(selected.FinishedAt) МСК</span> }</div></section> }
    <div class="danger-zone"><button class="button danger subtle" disabled="@busy" @onclick="() => confirmDelete = !confirmDelete">Удалить проект</button>
        @if (confirmDelete) { <span>Удалить настройки проекта и историю? <button class="button danger" disabled="@busy" @onclick="Delete">Да, удалить</button></span> }
    </div>
}
@code {
    [Parameter] public Guid Id { get; set; }
    private ProjectView? project;
    private List<DeploymentView> history = [];
    private DeploymentView? selected;
    private string? error, message;
    private bool busy, confirmDelete;
    private readonly CancellationTokenSource lifetime = new();
    private Guid? loadedId;
    protected override void OnInitialized() { _ = Poll(); }
    protected override async Task OnParametersSetAsync() {
        if (loadedId != Id) { loadedId = Id; project = null; selected = null; error = message = null; confirmDelete = false; await Refresh(); }
    }
    private async Task Refresh() {
        try { project = await Service.ProjectAsync(Id, lifetime.Token); history = await Service.HistoryAsync(Id, lifetime.Token);
            if (selected is null && history.Count > 0) selected = await Service.DeploymentAsync(history[0].Id, lifetime.Token);
            else if (selected is not null && Ui.Active(selected.Status)) selected = await Service.DeploymentAsync(selected.Id, lifetime.Token);
        } catch (OperationCanceledException) { } catch (Exception e) { error = Ui.Error(e); }
    }
    private async Task Select(Guid id) { try { selected = await Service.DeploymentAsync(id, lifetime.Token); } catch (Exception e) { error = Ui.Error(e); } }
    private async Task Deploy() { busy = true; error = message = null;
        try { var run = await Service.EnqueueAsync(Id, lifetime.Token); selected = run; await Refresh(); }
        catch (Exception e) { error = Ui.Error(e); } finally { busy = false; }
    }
    private async Task Check() { busy = true; error = message = null;
        try { message = await Ssh.CheckAsync(await Service.GetTargetAsync(Id, lifetime.Token), lifetime.Token); }
        catch (Exception e) { error = Ui.Error(e); } finally { busy = false; }
    }
    private async Task Delete() { busy = true; error = null;
        try { await Service.DeleteProjectAsync(Id, lifetime.Token); Navigation.NavigateTo("/"); }
        catch (Exception e) { error = Ui.Error(e); } finally { busy = false; }
    }
    private async Task Poll() { try { while (!lifetime.IsCancellationRequested) { await Task.Delay(1500, lifetime.Token); await InvokeAsync(async () => { await Refresh(); StateHasChanged(); }); } } catch (OperationCanceledException) { } }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}

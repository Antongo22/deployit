@page "/connections"
@attribute [Authorize]
@inject ProjectService Service
<PageTitle>Git-подключения · DeployIt</PageTitle>
<div class="page-heading"><div><div class="eyebrow">ИСТОЧНИКИ КОДА</div><h1>Git-подключения<span class="heading-dot">.</span></h1><p class="muted">Подключите аккаунт один раз и выбирайте доступные репозитории.</p></div></div>
@if (error is not null) { <div class="alert error" role="alert">@error</div> }
@if (message is not null) { <div class="alert success">@message</div> }
<div class="two-columns">
    <section class="panel"><div class="section-heading"><h2>Подключённые аккаунты</h2><span class="count">@connections.Count</span></div>
    @if (connections.Count == 0) { <div class="empty small"><span class="empty-symbol">⌘</span><p>GitHub или GitLab появятся здесь после подключения.</p></div> }
    @foreach (var connection in connections)
    {
        <div class="connection-item"><div class="card-top"><strong>@connection.Name</strong><span class="tag">@connection.Provider</span></div><p class="muted">@connection.Account · @(connection.PublicOnly ? "Публичные репозитории" : "Доступ по токену")</p><small class="mono muted">@connection.BaseUrl</small>
            <div class="inline-actions"><a href="/projects/new" class="button subtle">Создать проект ↗</a>
                @if (!connection.PublicOnly) { <button class="button subtle" disabled="@busy" @onclick="() => rotate = rotate == connection.Id ? null : connection.Id">Обновить токен</button> }
                <button class="button danger subtle" disabled="@busy" @onclick="() => confirm = confirm == connection.Id ? null : connection.Id">Удалить</button>
            </div>
            @if (confirm == connection.Id) { <div class="alert warning">Удалить подключение? <button class="button danger" disabled="@busy" @onclick="() => Delete(connection.Id)">Да, удалить</button></div> }
            @if (rotate == connection.Id) { <label>Новый токен того же аккаунта<input type="password" @bind="newToken" autocomplete="off" /></label><button class="button" disabled="@busy" @onclick="() => Rotate(connection.Id)">Сохранить токен</button> }
        </div>
    }
    </section>
    <section class="panel"><div class="eyebrow">НОВОЕ ПОДКЛЮЧЕНИЕ</div><h2>Откуда берём код?</h2>
    <p class="form-note">Сначала подключите Git-сервис и аккаунт. Конкретный репозиторий выберете на следующем шаге — при создании проекта.</p>
    <EditForm Model="input" OnValidSubmit="Add" FormName="connection">
        <DataAnnotationsValidator /><ValidationSummary />
        <label>Git-сервис<InputSelect @bind-Value="input.Provider" @bind-Value:after="ProviderChanged"><option value="@GitProvider.GitHub">GitHub</option><option value="@GitProvider.GitLab">GitLab</option></InputSelect></label>
        <label>Название подключения<InputText @bind-Value="input.Name" placeholder="Например, рабочий GitHub" /></label>
        <label>Адрес сервиса<InputText @bind-Value="input.BaseUrl" placeholder="@ServiceUrlExample" aria-describedby="service-url-help" /><small id="service-url-help">Только адрес сайта: <code>@ServiceUrlExample</code>@(input.Provider == GitProvider.GitLab ? " или https://gitlab.example.com для своего GitLab." : ".") Без имени аккаунта и названия репозитория: <code>@RepositoryUrlExample</code> здесь указывать не нужно.</small></label>
        <label class="checkbox"><InputCheckbox @bind-Value="input.PublicOnly" /> Только публичные репозитории, без токена</label>
        @if (input.PublicOnly) { <label>Имя аккаунта<InputText @bind-Value="input.Account" placeholder="@(input.Provider == GitProvider.GitHub ? "Например, octocat" : "Например, alex")" aria-describedby="account-help" /><small id="account-help">Только имя пользователя: <code>@(input.Provider == GitProvider.GitHub ? "octocat" : "alex")</code>. Без ссылки и названия репозитория.</small></label> }
        else
        {
            <label>Access token<InputText type="password" @bind-Value="input.Token" autocomplete="off" aria-describedby="token-help" /></label>
            <section id="token-help" class="token-help" aria-labelledby="token-help-title">
                <h3 id="token-help-title">Как получить токен @(input.Provider == GitProvider.GitHub ? "GitHub" : "GitLab")?</h3>
                @if (input.Provider == GitProvider.GitHub)
                {
                    <ol>
                        <li><a href="https://github.com/settings/personal-access-tokens/new?name=DeployIt&amp;contents=read&amp;metadata=read" target="_blank" rel="noopener noreferrer">Откройте создание токена в GitHub ↗</a> и войдите в аккаунт. Нужен <strong>Fine-grained personal access token</strong>.</li>
                        <li>Укажите название, например <code>DeployIt</code>, и срок действия. В <strong>Resource owner</strong> выберите владельца репозитория; в <strong>Repository access → Only select repositories</strong> — нужные репозитории.</li>
                        <li>В <strong>Repository permissions</strong> установите <strong>Contents → Read-only</strong> и <strong>Metadata → Read-only</strong>.</li>
                        <li>Нажмите <strong>Generate token</strong>, скопируйте токен и вставьте в поле выше. Если организация требует одобрения, дождитесь его.</li>
                    </ol>
                    <a href="https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens#creating-a-fine-grained-personal-access-token" target="_blank" rel="noopener noreferrer">Подробная инструкция GitHub ↗</a>
                }
                else
                {
                    <ol>
                        <li>
                            @if (GitLabTokenUrl is { } tokenUrl)
                            {
                                <a href="@tokenUrl" target="_blank" rel="noopener noreferrer">Откройте настройки токенов вашего GitLab ↗</a><span> и войдите в аккаунт.</span>
                            }
                            else
                            {
                                <span>Укажите HTTPS-адрес GitLab выше, чтобы появилась ссылка на настройки токенов.</span>
                            }
                            <span> Вручную: аватар → <strong>Edit profile → Access → Personal access tokens</strong>.</span>
                        </li>
                        <li>Нажмите <strong>Generate token → Legacy token</strong> (в старых версиях — <strong>Add new token</strong>). Укажите название, например <code>DeployIt</code>, и срок действия.</li>
                        <li>В <strong>Scopes</strong> отметьте <code>read_api</code> и <code>read_repository</code>.</li>
                        <li>Нажмите <strong>Generate token</strong> или <strong>Create personal access token</strong>, скопируйте токен и вставьте в поле выше. После закрытия страницы GitLab больше не покажет его.</li>
                    </ol>
                    <a href="https://docs.gitlab.com/user/profile/personal_access_tokens/#create-a-personal-access-token" target="_blank" rel="noopener noreferrer">Подробная инструкция GitLab ↗</a>
                }
            </section>
        }
        <p class="form-note">@(input.PublicOnly ? "Проверим, что аккаунт существует. Будут доступны только его публичные репозитории; токен не нужен." : "Токен проверяется при подключении и сохраняется в зашифрованном виде. Используйте personal access token из настроек Git-сервиса, а не пароль аккаунта.")</p>
        <button class="button primary full" type="submit" disabled="@busy">@(busy ? "Проверяем подключение…" : "Подключить аккаунт ↗")</button>
    </EditForm>
    </section>
</div>
@code {
    private List<ConnectionView> connections = [];
    private ConnectionInput input = new();
    private bool busy;
    private string? error, message;
    private string newToken = "";
    private Guid? confirm, rotate;
    protected override async Task OnInitializedAsync() { try { connections = await Service.ConnectionsAsync(); } catch (Exception e) { error = Ui.Error(e); } }
    private string ServiceUrlExample => input.Provider == GitProvider.GitHub ? "https://github.com" : "https://gitlab.com";
    private string RepositoryUrlExample => input.Provider == GitProvider.GitHub ? "https://github.com/octocat/Hello-World" : "https://gitlab.com/alex/my-app";
    private string? GitLabTokenUrl => Uri.TryCreate(input.BaseUrl?.Trim(), UriKind.Absolute, out var uri)
        && uri.Scheme == Uri.UriSchemeHttps && string.IsNullOrEmpty(uri.UserInfo)
        && uri.AbsolutePath == "/" && string.IsNullOrEmpty(uri.Query) && string.IsNullOrEmpty(uri.Fragment)
            ? uri.GetLeftPart(UriPartial.Authority) + "/-/user_settings/personal_access_tokens?name=DeployIt&scopes=read_api,read_repository"
            : null;
    private void ProviderChanged() { input.BaseUrl = ServiceUrlExample; error = message = null; }
    private async Task Add() { busy = true; error = message = null;
        try { await Service.AddConnectionAsync(input); input = new(); connections = await Service.ConnectionsAsync(); message = "Аккаунт подключён. Теперь можно создать проект."; }
        catch (Exception e) { error = Ui.Error(e); } finally { busy = false; }
    }
    private async Task Delete(Guid id) { busy = true; error = message = null;
        try { await Service.DeleteConnectionAsync(id); confirm = null; connections = await Service.ConnectionsAsync(); }
        catch (Exception e) { error = Ui.Error(e); } finally { busy = false; }
    }
    private async Task Rotate(Guid id) { busy = true; error = message = null;
        try { await Service.UpdateTokenAsync(id, newToken); newToken = ""; rotate = null; message = "Токен обновлён."; }
        catch (Exception e) { error = Ui.Error(e); } finally { busy = false; }
    }
}
